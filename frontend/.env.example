# Production (Vercel): call the public API directly — avoids broken same-origin rewrites
NEXT_PUBLIC_API_URL=https://careerpilot-api.vercel.app/api/v1

# Local dev: same-origin proxy via next.config rewrites
# NEXT_PUBLIC_API_URL=/api/v1

# Server-only: FastAPI origin used by next.config rewrites (local dev)
BACKEND_URL=http://localhost:8000

# Optional: public backend URL (used if NEXT_PUBLIC_API_URL is not absolute)
NEXT_PUBLIC_BACKEND_URL=https://careerpilot-api.vercel.app
