# App
ENVIRONMENT=development
LOG_LEVEL=INFO
SEED_ON_STARTUP=true

# Database — SQLite locally; use Postgres in production when available
DATABASE_URL=sqlite:///./careerpilot.db
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/careerpilot

# Comma-separated or JSON list
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI provider: gemini (default) or openai
AI_PROVIDER=gemini

# Free Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Optional later upgrade — OpenAI / compatible APIs
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
