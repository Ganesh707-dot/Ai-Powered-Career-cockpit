# App
ENVIRONMENT=development
LOG_LEVEL=INFO
SEED_ON_STARTUP=true

# Database — use Neon Postgres in production (see docs/NEON_DATABASE.md)
DATABASE_URL=sqlite:///./careerpilot.db
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Comma-separated or JSON list
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI provider: groq (free tier), gemini, or openai
AI_PROVIDER=groq

# Groq — https://console.groq.com (same pattern as wellness project)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Free Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Optional — OpenAI / compatible APIs
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
